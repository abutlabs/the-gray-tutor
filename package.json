{
  "name": "the-gray-tutor",
  "private": true,
  "type": "module",
  "description": "Build a JAM client in TypeScript, one Gray Paper rule at a time.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "site": "node tools/need-node.mjs && vitepress dev --open",
    "site:build": "node tools/need-node.mjs && vitepress build",
    "vectors": "node tools/need-node.mjs && node tools/vectors.ts",
    "compare": "node tools/need-node.mjs && node tools/compare.ts",
    "catch-up": "node tools/need-node.mjs && node tools/compare.ts --write",
    "verify": "node tools/need-node.mjs && node tools/verify.ts",
    "screenshots": "node tools/need-node.mjs && node tools/screenshots.ts",
    "diagrams": "node tools/need-node.mjs && node tools/diagrams.ts",
    "epub": "node tools/need-node.mjs && EPUB=1 vitepress build",
    "test": "node tools/need-node.mjs && node --test \"tools/*.test.ts\"",
    "typecheck": "tsc -p tools",
    "check": "node tools/need-node.mjs && npm run typecheck && npm test && npm run site:build",
    "scoreboard": "node client/bin/scoreboard.ts",
    "demo": "node tools/need-node.mjs && node tools/compare.ts --last --write --dir demo && npm install --prefix demo --no-audit --no-fund",
    "offline": "node tools/need-node.mjs && node tools/offline.ts"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "@xmldom/xmldom": "0.9.10",
    "cheerio": "1.2.0",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "markdown-it-mathjax3": "4.3.2",
    "nspell": "2.1.5",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  }
}
